*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.hypothesis/
state/

# What a test run leaves behind.  This directory syncs through pCloud, so an
# untracked file left by `pytest` dirties main and blocks a merge.
.coverage
.tmp-pytest-local/

# Windows shortcuts: machine-specific, rewritten by Windows, drift constantly
*.lnk

# libmpv binary (fetched locally, not committed — see README)
vendor/

# Private overlays — real values live here and never get published; each has
# a committed *.example.* template documenting its shape.
/genau_config.json

# pCloud conflict copies (this dir syncs via pCloud). Never our files; an
# untracked one dirties main and blocks merges. '[' escaped to match literally.
*\[conflicted*
